# ==== Telegram ====
BOT_TOKEN=123456789:AAF...your-bot-token-from-BotFather
# ID прежнего единственного владельца: сохраняет доступ к существующей bot.db.
# Не меняйте его на ID другого человека! Для нового пользователя — список ниже.
ALLOWED_USER_ID=123456789
# Общий whitelist (через запятую; также поддерживаются пробелы/точка с запятой).
# Пустые оба ALLOWED_* = доступ закрыт. Работает только в личных чатах.
ALLOWED_USER_IDS=123456789
# Независимый платный whitelist, пока только ваш ID. Добавляйте и в общий список.
# Это ручная выдача доступа, НЕ платёжная интеграция. Пусто = платных пользователей нет.
PAID_USER_IDS=123456789

# ==== AI: любой провайдер по OpenAI-контракту (рекомендуется) ====
# Достаточно LLM_API_URL + LLM_API_KEY + LLM_MODEL. Примеры:
#   ProxyAPI (РФ, рубли):  https://api.proxyapi.ru/openai/v1
#   VseGPT (РФ, рубли):    https://api.vsegpt.ru/v1
#   OpenRouter:            https://openrouter.ai/api/v1
#   OpenAI:                https://api.openai.com/v1
#   DeepSeek:              https://api.deepseek.com/v1
#   Ollama (локально):     http://localhost:11434/v1   (ключ можно не указывать)
LLM_API_URL=
LLM_API_KEY=
# Дефолт — самая стабильная free-модель OpenRouter на 27.09.2026 (проверено 3/3 дня, 20 RPM / 50-1000 RPD):
# nvidia/nemotron-3-super-120b — надёжна и хорошо держит JSON; фолбеки ниже подстрахуют на 429.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Fallback-цепочка если primary упёрся в лимит/упал (через запятую, пробуется по порядку):
LLM_FALLBACK_MODELS=cohere/north-mini-code:free,inclusionai/ling-3.0-flash-fin:free,liquid/lfm-2.5-2.6b:free,openrouter/free
# Лимитер + ретраи: 18 RPM безопасно ниже 20; 3 ретрая с бэкоффом + фолбек по моделям
LLM_RATE_LIMIT_RPM=18
LLM_MAX_RETRIES=3
# Общий бюджет цепочки (включая лимитер и паузы); затем локальный парсер.
LLM_TOTAL_TIMEOUT=35
LLM_MAX_TOKENS=4096
LLM_MAX_TOKENS_LIMIT=8192
# ВАЖНО: имя модели должно существовать у провайдера.
# Для OpenRouter формат 'vendor/model', бесплатные — с суффиксом ':free'
# (актуальный список: openrouter.ai/models с фильтром цены 0, живой чек: klymentiev.com/blog/openrouter-free-tier).
# Примеры paid: gpt-4o-mini, deepseek-chat; free стабильные см. выше.
# Строгий JSON через response_format (провайдеры без поддержки откатываются автоматически):
LLM_JSON_MODE=true
# Распознавание голосовых через того же провайдера (audio/transcriptions):
LLM_VOICE_MODEL=whisper-1
# false — если провайдер не умеет транскрибировать (голосовые скажут об этом)
LLM_STT_ENABLED=true
# Голос на отдельном провайдере, чем LLM (issue #12). Нужно, когда LLM — на
# бесплатных моделях (напр. OpenRouter :free), а аудио у этого провайдера
# платное (OpenRouter audio: только платно, минимум $0.50 баланса).
# Бесплатный вариант — Groq (free plan ~2000 req/день, 20 req/мин,
# 7200 сек аудио/час):
#   STT_API_URL=https://api.groq.com/openai/v1
#   STT_API_KEY=gsk_...
#   STT_MODEL=whisper-large-v3-turbo
# Пустые = фолбэк на LLM_API_URL / LLM_API_KEY / LLM_VOICE_MODEL (по позиции).
STT_API_URL=
STT_API_KEY=
STT_MODEL=

# ==== Альтернатива: нативный GigaChat (OAuth Сбера) ====
# Используется только если LLM_API_URL пуст. Подробнее: developers.sber.ru/gigachat
GIGACHAT_API_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Сертификат Минцифры (рекомендуется):
# curl -o data/russian_trusted_root_pem.cer https://gu-st.ru/content/lending/russian_trusted_root_pem.cer
GIGACHAT_CA_CERT=
GIGACHAT_VERIFY_TLS=false

# ==== Google Calendar (см. docs/SETUP_GOOGLE.md) ====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Если пусто — бот работает в режиме .ics-файлов

# ==== Общие настройки ====
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_CALENDAR_ID=primary
DB_PATH=data/bot.db
# Fernet-ключ для шифрования токенов; если пусто — сгенерируется в data/secret.key
ENCRYPTION_KEY=
LOG_LEVEL=INFO  # DEBUG — подробно (HTTP, AI-сырьё); INFO — штатно
