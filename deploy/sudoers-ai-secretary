# Минимальные права sudo для деплоя ai-secretary из GitHub Actions.
#
# Зачем: deploy/remote-deploy.sh управляет только своим юнитом (stop/start/
# restart/is-active/status) и читает его журнал. Полный sudo деплою не нужен.
#
# Установка (от пользователя деплоя, у которого есть sudo):
#   sudo sed -e "s|__USER__|$(id -un)|g" -e "s|__SERVICE__|ai-secretary|g" \
#       deploy/sudoers-ai-secretary | sudo tee /etc/sudoers.d/ai-secretary >/dev/null
#   sudo chmod 440 /etc/sudoers.d/ai-secretary
#   sudo visudo -c            # проверка синтаксиса, должно быть «parsed OK»
#
# Проверка, что работает: sudo -n systemctl is-active ai-secretary
#
# Если systemctl у вас не в /usr/bin (проверьте: command -v systemctl),
# поправьте пути ниже на фактический.

__USER__ ALL=(root) NOPASSWD: \
    /usr/bin/systemctl start __SERVICE__, \
    /usr/bin/systemctl stop __SERVICE__, \
    /usr/bin/systemctl restart __SERVICE__, \
    /usr/bin/systemctl is-active __SERVICE__, \
    /usr/bin/systemctl status __SERVICE__, \
    /usr/bin/systemctl status __SERVICE__ --no-pager -l, \
    /usr/bin/journalctl -u __SERVICE__ *
