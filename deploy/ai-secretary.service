[Unit]
Description=AI Secretary — Telegram-бот (ai-secretary)
Documentation=https://github.com/RedRad1sh/ai-secretary/blob/master/docs/DEPLOY_VPS.md
After=network-online.target
Wants=network-online.target

# Не останавливаться после серии падений: бот должен подниматься всегда.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__APP_DIR__

# Секреты подхватывает сам бот из __APP_DIR__/.env (python-dotenv, BASE_DIR/.env).
# Дублировать их в Environment= не нужно. Если переменную надо переопределить
# для сервиса — раскомментируйте строку ниже (значение из окружения имеет
# приоритет над .env):
# Environment=LOG_LEVEL=INFO

# Небуферизованный stdout: строки сразу попадают в journalctl.
Environment=PYTHONUNBUFFERED=1

ExecStart=__APP_DIR__/.venv/bin/python -m bot.main

# Перезапуск при падении + при ребуте сервера.
Restart=always
RestartSec=5

# SIGINT (как Ctrl+C) — бот корректно закроет БД, сессию Telegram и планировщик.
KillSignal=SIGINT
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-secretary

# ── Ограничения: сервис не должен влиять на «соседей» по VPS ─────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# data/ — БД, ключ шифрования, логи; это единственное, что сервису нужно писать.
ReadWritePaths=__APP_DIR__/data
# Когда приложений несколько, имеет смысл закрепить лимиты (под свой тариф):
# MemoryMax=512M
# CPUQuota=80%
# Смотреть фактическое потребление: systemd-cgtop

[Install]
WantedBy=multi-user.target
